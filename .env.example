# CampusHire Frontend Environment Configuration
# Copy this file to .env and configure your actual settings.
# NEVER commit your actual .env file or production secrets to source control.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Toggle mock mode for offline demonstration (true | false)
VITE_USE_MOCK_API=false

# Firebase Client Configuration
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
