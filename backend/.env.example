# CampusHire Backend Environment Configuration
# Copy this file to .env and provide your actual environment settings.
# NEVER commit your .env file or real secrets to source control.

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/campushire?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campushire?retryWrites=true&w=majority

# Firebase Admin SDK Configuration
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Master Administrative Secret for Provisioning Placement Officers
# (Required in header x-officer-provision-key for POST /api/auth/provision-officer)
OFFICER_PROVISION_SECRET=your-random-secure-secret-for-admin-officer-provisioning

# Development Mock Auth Flag (Set to true only for local offline developer testing)
ALLOW_DEV_AUTH=false
